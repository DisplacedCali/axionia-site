# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never prefix with NEXT_PUBLIC_.
# Powers the admin section (bypasses RLS).
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Research pipeline ────────────────────────────────────
# Direct Postgres connection. SERVER ONLY — as sensitive as the service role
# key, since it also bypasses RLS.
#
# Needed because the research pipeline stores state in the `research` schema,
# which is deliberately NOT listed under Project Settings → API → Exposed
# schemas. PostgREST therefore doesn't serve it and supabase-js cannot reach
# it at all — that isolation is the point, so this is the only way in.
#
# Where to get it: Supabase Dashboard → the "Connect" button at the top of the
# project page → Connection string → *Transaction pooler*.
#
#   postgres://postgres.<project-ref>:<PASSWORD>@aws-<region>.pooler.supabase.com:6543/postgres
#
# Use TRANSACTION mode (port 6543), not the direct connection (5432):
#   · transaction mode is the documented choice for serverless/edge
#   · the shared pooler is IPv4 on every tier; the direct endpoint is IPv6-only
#     without the IPv4 add-on
#
# <PASSWORD> is your DATABASE password, not any API key. Reset it under
# Project Settings → Database if you don't have it. URL-encode special
# characters (@ → %40, # → %23, etc.) or the URL won't parse.
#
# Note: transaction mode doesn't support prepared statements. lib/modules/
# research/db.ts never names a query, and node-postgres only prepares named
# queries, so this is safe as written — but keep it that way.
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-us-east-1.pooler.supabase.com:6543/postgres

# Anthropic API key for the research pipeline. SERVER ONLY.
ANTHROPIC_API_KEY=sk-ant-your-key

# Optional overrides.
# claude-sonnet-4-6 is the current default; claude-sonnet-5 is newer.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# RESEARCH_MAX_TOKENS=1500

# ── Site ─────────────────────────────────────────────────
# Used to build absolute links in outbound email.
NEXT_PUBLIC_SITE_URL=https://axionia.com

# ── Email (Resend) ───────────────────────────────────────
# Verify axionia.com in Resend, add the DNS records in Cloudflare.
# Mail sends FROM your domain with replies routed to Google Workspace.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Axionia <reports@axionia.com>
EMAIL_REPLY_TO=tom@axionia.com

# Where new-request notifications go (your Workspace inbox).
ADMIN_NOTIFY_EMAIL=tom@axionia.com

# Signs share links for the gated founders deck (/deck/founders?k=...).
# Any random string of 24+ characters; shorter is treated as unset, because a
# weak secret here looks like protection without being it. Rotating this value
# invalidates every outstanding share link at once — that's the revocation
# mechanism, so pick it deliberately and keep it out of the client bundle.
#   openssl rand -base64 48
DECK_LINK_SECRET=
